{
  "name": "PulseAnalytics",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.114.json",
  "dataColors": [
    "#2a78d6", "#eb6834", "#1baf7a", "#eda100",
    "#e87ba4", "#008300", "#4a3aa7", "#e34948"
  ],
  "good": "#0ca30c",
  "neutral": "#fab219",
  "bad": "#d03b3b",
  "maximum": "#104281",
  "center": "#f0efec",
  "minimum": "#cde2fb",
  "null": "#898781",
  "background": "#f9f9f7",
  "foreground": "#0b0b0b",
  "tableAccent": "#2a78d6",
  "textClasses": {
    "title":      { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0b0b0b" },
    "header":     { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label":      { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#52514e" },
    "callout":    { "fontFace": "Segoe UI",          "fontSize": 30, "color": "#0b0b0b" },
    "largeTitle": { "fontFace": "Segoe UI Semibold", "fontSize": 18, "color": "#0b0b0b" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background":   [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border":       [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 8 }],
        "visualHeader": [{ "show": false }],
        "categoryAxis": [{
          "showAxisTitle": false, "gridlineShow": false,
          "lineColor": { "solid": { "color": "#c3c2b7" } },
          "labelColor": { "solid": { "color": "#898781" } }
        }],
        "valueAxis": [{
          "showAxisTitle": false,
          "gridlineShow": true, "gridlineStyle": "solid", "gridlineThickness": 1,
          "gridlineColor": { "solid": { "color": "#e1e0d9" } },
          "labelColor": { "solid": { "color": "#898781" } }
        }],
        "legend": [{ "position": "TopLeft", "showTitle": false,
                     "labelColor": { "solid": { "color": "#52514e" } } }]
      }
    }
  }
}
