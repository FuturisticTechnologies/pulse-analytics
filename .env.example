# ---------------------------------------------------------------------------
# PulseAnalytics configuration. Copy to `.env` and edit; every value below is
# already the default, so the platform runs with no .env at all.
# ---------------------------------------------------------------------------

# --- Warehouse engine: duckdb (zero-install, default) | postgres (docker) ---
PULSE_DB_ENGINE=duckdb
PULSE_DUCKDB_PATH=data/warehouse/pulse.duckdb

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=pulse
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse

# --- Event bus: local (NDJSON files, default) | kafka (Redpanda in docker) ---
PULSE_STREAM_BACKEND=local
PULSE_KAFKA_BROKERS=localhost:19092
PULSE_STREAM_DIR=data/stream
PULSE_CONSUMER_GROUP=pulse-analytics

# --- Synthetic dataset shape ---
PULSE_SEED=20240101
PULSE_N_CUSTOMERS=4000
PULSE_N_PRODUCTS=320
PULSE_N_ORDERS=60000
PULSE_N_EVENTS=150000
PULSE_N_CAMPAIGNS=48
PULSE_END_DATE=2025-12-31

# --- Business rules (see docs/kpi-definitions.md) ---
PULSE_CHURN_WINDOW_DAYS=90
PULSE_CURRENCY=USD

# --- Where data lives ---
# On Azure these become ADLS mount points; nothing in the code changes.
PULSE_RAW_DIR=data/raw
PULSE_WAREHOUSE_DIR=data/warehouse
PULSE_EXPORT_DIR=data/exports

# --- Logging ---
PULSE_LOG_LEVEL=INFO
